# Application Configuration
PROJECT_NAME="SIH26264 Complaint Intelligence"
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# Security & Authentication
# Replace with a cryptographically secure random string in production
SECRET_KEY=dev_secret_key_change_in_production_min_32_characters_long_sih26264
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Database Configuration (PostgreSQL)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL=postgresql+psycopg2://aicte_admin:postgres_dev_password@localhost:5432/aicte_complaints

# CORS Allowed Origins (JSON array of allowed frontend URLs)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# File Upload & Evidence Storage Directory
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25
